# 生产环境变量配置
NODE_ENV=production
PORT=3000

# RPC 节点（请替换为实际值）
ETH_NODE=https://eth.llamarpc.com
BSC_NODE=https://bsc-dataseed.binance.org
BSC_TESTNET_NODE=https://data-seed-prebsc-1-s1.binance.org:8545
SIMPLECHAIN_NODE=https://rpc.simplechain.com

# 子图 API（请替换为实际值）
THE_GRAPH_API_KEY=
NODE_REAL_SUBGRAPH_API_KEY=

# Explorer API（请替换为实际值）
EXPLORER_API_KEY=

# 缓存配置
CACHE_TTL=900
CACHE_MAX_ITEMS=1000

# CORS
CORS_ORIGIN=*
